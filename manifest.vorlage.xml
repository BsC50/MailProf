<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>17acc5d2-e89f-4f99-a43c-aaba3faf68ac</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Eveline</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Mail-Prüfer"/>
  <Description DefaultValue="Prüft ausgehende Mails auf Rechtschreibung, fehlende Anhänge, Anrede und Grussformel, bevor sie gesendet werden."/>
  <IconUrl DefaultValue="{BASIS}/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{BASIS}/assets/icon-128.png"/>
  <SupportUrl DefaultValue="{BASIS}/taskpane.html"/>
  <AppDomains>
    <AppDomain>{BASIS}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{BASIS}/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Hintergrund.Url">
              <Override type="javascript" resid="HintergrundJS.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Hintergrund.Url"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mailprueferGruppe">
                  <Label resid="Gruppe.Label"/>
                  <Control xsi:type="Button" id="mailprueferOeffnen">
                    <Label resid="Knopf.Label"/>
                    <Supertip>
                      <Title resid="Knopf.Label"/>
                      <Description resid="Knopf.Tipp"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Seitenleiste.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="beimSenden" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="Hintergrund.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{BASIS}/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{BASIS}/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{BASIS}/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Hintergrund.Url" DefaultValue="{BASIS}/commands.html"/>
          <bt:Url id="HintergrundJS.Url" DefaultValue="{BASIS}/pruefung.js"/>
          <bt:Url id="Seitenleiste.Url" DefaultValue="{BASIS}/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Gruppe.Label" DefaultValue="Mail-Prüfer"/>
          <bt:String id="Knopf.Label" DefaultValue="Mail prüfen"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Knopf.Tipp" DefaultValue="Zeigt Fehler in deiner Mail und schlägt Korrekturen vor."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
